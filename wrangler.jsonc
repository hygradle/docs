{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "hygradle-docs",
	"compatibility_date": "2026-02-28",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
	},
	"observability": {
		"enabled": true,
	},
	"send_metrics": false,
	"placement": {
		"mode": "smart",
	},
}
